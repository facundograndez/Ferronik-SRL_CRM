# FASE 0 reference only. FASE 1A/1B will create separate .env.example files
# in Ferronik-SRL_Backend and Ferronik-SRL_Frontend. Do not use this file as
# evidence of a shared runtime.

# Frontend public configuration (Vercel; never place secrets here)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Backend runtime (Railway/local)
NODE_ENV=development
APP_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-bytes

# PostgreSQL. Runtime uses pooled URL; migrations use a direct URL.
DATABASE_URL=postgresql://user:password@pooler.example/ferronik_dev?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@primary.example/ferronik_dev?sslmode=require

# Transactional email / password recovery
EMAIL_PROVIDER=disabled
EMAIL_FROM=erp@example.invalid
EMAIL_API_KEY=

# Object storage (S3-compatible)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ARCA (disabled outside production unless explicitly using homologation)
ARCA_MODE=disabled
ARCA_CUIT=
ARCA_CERTIFICATE_BASE64=
ARCA_PRIVATE_KEY_BASE64=

# Mercado Libre
MELI_MODE=disabled
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=
MELI_WEBHOOK_SECRET=

# Meta / WhatsApp
META_MODE=disabled
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Currency provider
CURRENCY_PROVIDER=manual
CURRENCY_API_URL=
CURRENCY_API_KEY=

# Observability / rate limiting (provider selected in FASE 1)
LOG_LEVEL=info
ERROR_REPORTING_DSN=
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
